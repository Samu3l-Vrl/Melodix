# =============================================================================
# Jukebox — variables d'environnement (valeurs prêtes pour Laravel Sail)
# Copier en .env puis : ./vendor/bin/sail artisan key:generate
# =============================================================================

APP_NAME=Jukebox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# IMPORTANT : Spotify refuse "http://localhost" comme URI de redirection OAuth.
# En local, l'hôte doit ouvrir l'application sur http://127.0.0.1 (adresse de bouclage autorisée).
APP_URL=http://127.0.0.1
APP_PORT=80

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Jukebox ------------------------------------------------------------------
# URL joignable par les téléphones des invités, encodée dans le QR code.
# Mettre l'IP de votre machine sur le Wi-Fi, ex. http://192.168.1.20 (vide = APP_URL).
JUKEBOX_PUBLIC_URL=
JUKEBOX_INACTIVITY_HOURS=12

# --- PostgreSQL 16 (service "pgsql" de Sail) -------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=jukebox
DB_USERNAME=sail
DB_PASSWORD=password

# --- Redis (service "redis" de Sail) : cache des recherches, sessions, verrous ----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=jukebox_cache_

SESSION_DRIVER=redis
# 12 h : une soirée entière sans que l'hôte soit déconnecté.
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Les events sont en ShouldBroadcastNow : aucune file de jobs n'est nécessaire.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Temps réel : Laravel Reverb ---------------------------------------------
BROADCAST_CONNECTION=reverb

# Identifiants de l'application Reverb (valeurs libres en local, à changer en production).
REVERB_APP_ID=jukebox
REVERB_APP_KEY=jukebox-local-key
REVERB_APP_SECRET=jukebox-local-secret

# Côté SERVEUR : où Laravel publie les events. "reverb" = nom du service Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Adresse d'écoute du serveur Reverb DANS son conteneur.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Côté NAVIGATEUR : où Echo ouvre le WebSocket.
# VITE_REVERB_HOST vide = même nom d'hôte que la page (127.0.0.1 pour l'hôte,
# l'IP du réseau local pour les téléphones). Ne le renseigner que derrière un domaine dédié.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Vite (serveur de développement) --------------------------------------------
VITE_PORT=5173
# Mettre "true" si le projet est sur un disque Windows monté dans WSL (/mnt/c/…) :
# les notifications de fichiers n'y fonctionnent pas, Vite doit scruter les fichiers.
VITE_USE_POLLING=false

# --- Spotify : https://developer.spotify.com/dashboard --------------------------
# Redirect URI à déclarer dans le dashboard : http://127.0.0.1/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/auth/spotify/callback"
# Pays du catalogue utilisé pour la recherche (ISO 3166-1 alpha-2).
SPOTIFY_MARKET=FR

# --- YouTube Data API v3 : https://console.cloud.google.com ---------------------
YOUTUBE_API_KEY=
# Budget quotidien que s'autorise l'application (quota Google par défaut : 10 000).
YOUTUBE_DAILY_QUOTA=9500

# --- Sail ---------------------------------------------------------------------
WWWUSER=1000
WWWGROUP=1000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_REVERB_PORT=8080
