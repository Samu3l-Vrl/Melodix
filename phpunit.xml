<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Cache en mémoire : chaque test repart d'un cache vide, sans dépendre de Redis. -->
        <env name="CACHE_STORE" value="array"/>
        <!-- Base PostgreSQL dédiée "testing" (créée par Sail au premier démarrage du conteneur pgsql). -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="testing"/>
        <!-- Aucun serveur Reverb nécessaire : les events sont vérifiés avec Event::fake(). -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Fausses clés : aucun appel réseau réel, tout passe par Http::fake(). -->
        <env name="SPOTIFY_CLIENT_ID" value="test-spotify-id"/>
        <env name="SPOTIFY_CLIENT_SECRET" value="test-spotify-secret"/>
        <env name="YOUTUBE_API_KEY" value="test-youtube-key"/>
        <env name="YOUTUBE_DAILY_QUOTA" value="9500"/>
        <env name="REVERB_APP_ID" value="test-app"/>
        <env name="REVERB_APP_KEY" value="test-key"/>
        <env name="REVERB_APP_SECRET" value="test-secret"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
